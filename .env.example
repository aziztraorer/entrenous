# Environment Variables - Entre Nous

# ============================================================================
# FRONTEND (.env should be in frontend/ directory)
# ============================================================================

# API Configuration
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000

# Environment
VITE_ENV=development
VITE_DEBUG=true

# ============================================================================
# BACKEND (.env should be in backend/ directory)
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/entre_nous
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Socket.IO Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:5173
SOCKET_IO_PING_INTERVAL=25000
SOCKET_IO_PING_TIMEOUT=60000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Game Configuration
GAME_EXPIRY_HOURS=24
GAME_INACTIVE_TIMEOUT_HOURS=24
GAME_CODE_LENGTH=6
GAME_MAX_PLAYERS=2
CHALLENGE_TIME_LIMIT_SECONDS=300

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional: Sentry Error Tracking (future)
SENTRY_DSN=

# Optional: Email Service (future)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Optional: Monitoring (future)
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

# ============================================================================
# DOCKER / DEPLOYMENT
# ============================================================================

# Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=entre_nous
POSTGRES_HOST=db

# Deployment
DEPLOY_ENV=production
API_URL=https://api.entrenous.app
FRONTEND_URL=https://entrenous.app
