# Entre Nous - Database Environment Variables

# Database Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# DO NOT use real passwords in version control!
DATABASE_URL=postgresql://postgres:password@localhost:5432/entre_nous

# PostgreSQL Connection Details (for reference)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=entre_nous

# Connection Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Application Settings
NODE_ENV=development
PORT=3000

# JWT Token Configuration
JWT_SECRET=your-super-secret-key-change-in-production-at-least-32-characters-long
JWT_EXPIRES_IN=24h

# Logging
LOG_LEVEL=info

# API Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ⚠️ IMPORTANT:
# - Never commit this file with real passwords/secrets
# - Create a local .env file with your actual credentials
# - .env is already in .gitignore
